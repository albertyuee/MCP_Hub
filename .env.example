# ─── MySQL ────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# ─── Hive ─────────────────────────────────────────────
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USERNAME=hive
HIVE_PASSWORD=
HIVE_DATABASE=default
HIVE_AUTH=NONE          # NONE | CUSTOM | KERBEROS

# ─── MCP Server ───────────────────────────────────────
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ─── Query Safety ─────────────────────────────────────
QUERY_MAX_ROWS=1000       # 单次查询最大返回行数
QUERY_TIMEOUT=30          # 查询超时秒数
CACHE_TTL=300             # 结果缓存秒数（0=关闭缓存）

# ─── Web UI ───────────────────────────────────────────
WEB_PORT=7860
